<!-- File: resources.qrc -->
<RCC>
    <qresource prefix="/">
        <!-- QML pages -->
        <file alias="CodeLineBadge.qml">qml/CodeLineBadge.qml</file>
        <file alias="DemoMain.qml">qml/DemoMain.qml</file>
        <file alias="FadeContainer.qml">qml/FadeContainer.qml</file>
        <file alias="Page1.qml">qml/Page1.qml</file>
        <file alias="Page2.qml">qml/Page2.qml</file>
        <file alias="Page3.qml">qml/Page3.qml</file>
        <file alias="Page4.qml">qml/Page4.qml</file>
        <file alias="Page5.qml">qml/Page5.qml</file>
        <file alias="Page6.qml">qml/Page6.qml</file>
        <file alias="Page7.qml">qml/Page7.qml</file>
        <file alias="Page8.qml">qml/Page8.qml</file>
        <file alias="Page9.qml">qml/Page9.qml</file>

        <!-- For the standalone test/debug version -->
        <file alias="StandaloneView.qml">qml/StandaloneView.qml</file>

        <!-- Images -->
        <file alias="assets/hex-browser.svg">assets/hex-browser.svg</file>
        <file alias="assets/hexdev_logo.svg">assets/hexdev_logo.svg</file>

        <!-- A video -->
        <file alias="assets/hexdev_logo_video.webm">assets/hexdev_logo_video.webm</file>

        <!-- A 3D model -->
        <file alias="assets/hexdev_logo.glb">assets/hexdev_logo.glb</file>

    </qresource>
</RCC>
